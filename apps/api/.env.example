# ── 공통 ──
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://plit:plit@localhost:5432/plit_dev?schema=public
REDIS_URL=redis://localhost:6379

# ── 인증 ── (운영에서는 Secrets Manager 주입, 32바이트 이상 난수)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ── 소셜 로그인 (앱 등록 전에는 비워두면 해당 provider 비활성) ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:4000/api/v1/auth/oauth

# ── 결제 ── PAYMENT_PROVIDER=MOCK | TOSS. 실가맹 키 발급 전에는 TOSS 테스트 키(test_sk_...)만 사용
PAYMENT_PROVIDER=MOCK
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=

# ── 보상 ── 법률 검토·운영 승인 전에는 반드시 false (가상 포인트)
REWARDS_LIVE=false

# ── AI ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT_FREE=3
AI_DAILY_LIMIT_PREMIUM=30

# ── 관리자 2단계 인증 ── (미설정: production/staging=true)
ADMIN_MFA_REQUIRED=
MFA_ENC_KEY=

# ── 공공데이터포털 (발급 후 입력, 현재 호출하지 않음) ──
QNET_SERVICE_KEY=
