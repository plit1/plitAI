// PLIT 정식 서비스 DB 스키마
// 원칙
//  - 금액은 원(KRW) 정수, 포인트는 P 정수. 부동소수 사용 금지.
//  - 포인트/XP는 append-only 원장. 잔액은 원장 합계(+캐시 컬럼은 같은 트랜잭션에서만 갱신).
//  - 경제적 가치 이벤트는 dedupeKey 유니크로 멱등성 보장.
//  - 테스트 데이터는 isTest=true 로 표시해 집계·정산에서 제외.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── 회원 · 인증 ─────────────────────────

enum UserRole {
  USER
  OPERATOR // 일반 운영자: 심사·커뮤니티 관리
  SUPER_ADMIN // 최고 관리자: 정책·환불·포인트 수동 지급
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN // 탈퇴(개인정보 익명화 완료)
}

enum AuthProvider {
  EMAIL
  KAKAO
  NAVER
  GOOGLE
}

model User {
  id            String     @id @default(cuid())
  email         String?    @unique // 탈퇴 시 null 처리
  emailVerified Boolean    @default(false)
  passwordHash  String?
  nickname      String
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  referralCode  String     @unique
  referredById  String?
  mfaSecret     String? // TOTP 시크릿 (AES-256-GCM 암호문)
  mfaEnabledAt  DateTime? // null 이면 미활성 (등록 중)
  mfaLastStep   Int? // 마지막으로 사용된 TOTP 시간 단계 (재사용 방지)
  isTest        Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  withdrawnAt   DateTime?

  referredBy       User?                   @relation("Referral", fields: [referredById], references: [id])
  referrals        User[]                  @relation("Referral")
  identities       AuthIdentity[]
  refreshTokens    RefreshToken[]
  resetTokens      PasswordResetToken[]
  consents         UserConsent[]
  favorites        FavoriteCertification[]
  enrollments      Enrollment[]
  passes           BoosterPass[]
  orders           Order[]
  pointEntries     PointLedgerEntry[]      @relation("PointOwner")
  xpEntries        XpLedgerEntry[]
  studySessions    StudySession[]
  verifications    PassVerification[]
  pointAccount     PointAccount?
  auditLogs        AdminAuditLog[]         @relation("AuditActor")
  openRunRequests  OpenRunRequest[]        @relation("OpenRunRequester")
  openRunInterests OpenRunInterest[]
  quizAttempts     QuizAttempt[]
  posts            CommunityPost[]
  comments         CommunityComment[]
  chatMessages     ChatMessage[]
  aiUsage          AiUsageLog[]

  @@index([status])
}

/// 소셜 로그인 계정 연결. (provider, providerUserId) 유일 → 중복 가입 방지
model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// 회전식 refresh 토큰. 원문은 저장하지 않고 SHA-256 해시만 저장.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String // 재사용 탐지 시 동일 family 전체 폐기
  mfa        Boolean   @default(false) // MFA 로 시작된 세션이면 회전 후에도 유지
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ConsentType {
  TERMS // 이용약관 (필수)
  PRIVACY // 개인정보 수집·이용 (필수)
  AGE_14 // 만 14세 이상 (필수)
  MARKETING // 마케팅 수신 (선택)
  STUDY_DATA_ANALYTICS // 학습 데이터 비교 분석 (선택)
}

/// 동의 이력 (철회도 새 행으로 기록 — 이력 보존)
model UserConsent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  version   String
  agreed    Boolean
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ───────────────────────── 자격증 ─────────────────────────

enum ChallengeType {
  exam
  edu_exam
  completion
  score
}

model Certification {
  id            String        @id // 데모와 동일한 slug ID (예: industrial-safety)
  name          String
  field         String // care, beauty, food, life, office, edu, biz, lang
  qualType      String // 국가기술, 국가전문, 국가자격, 국가공인 민간, 민간, 국가공인, 어학
  challengeType ChallengeType
  issuer        String
  difficulty    Int
  tagline       String
  passRule      String
  subjects      String[]
  description   String?
  relatedJobs   String[]      @default([])
  qnetJmCd      String? // 큐넷 종목코드 (시험일정 API 연동 키)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  offerings  ChallengeOffering[]
  favorites  FavoriteCertification[]
  examRounds ExamRound[]

  @@index([field])
  @@index([qualType])
}

/// 공식 시험 회차 (큐넷/공공데이터 동기화 대상)
model ExamRound {
  id              String        @id @default(cuid())
  certId          String
  label           String // 예: 2027년 1회
  applyStart      DateTime?
  applyEnd        DateTime?
  examDate        DateTime
  resultDate      DateTime?
  source          String        @default("MANUAL") // MANUAL | QNET_API
  sourceUpdatedAt DateTime?
  cert            Certification @relation(fields: [certId], references: [id])

  @@unique([certId, label])
}

model FavoriteCertification {
  userId    String
  certId    String
  notify    Boolean       @default(false)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cert      Certification @relation(fields: [certId], references: [id])

  @@id([userId, certId])
}

// ───────────────────────── 챌린지 ─────────────────────────

enum OfferingStatus {
  draft
  open
  closed // 모집 마감
  running
  ended
  cancelled
}

enum Plan {
  FREE // 플릿런 (TOGETHER_RUN)
  PREMIUM // 플릿 부스터 패스 (BOOSTER_RUN)
}

/// 챌린지 회차. 데모의 offering 과 1:1 대응 (id 형식 `{certId}-{yyyy}-{n}`)
model ChallengeOffering {
  id            String         @id
  certId        String
  round         String
  recruitEnd    DateTime
  examDate      DateTime
  durationDays  Int
  freeCap       Int            @default(300)
  premiumCap    Int            @default(300)
  freeJoined    Int            @default(0) // 정원 카운터 (트랜잭션 내 조건부 증가)
  premiumJoined Int            @default(0)
  status        OfferingStatus @default(open)
  hidden        Boolean        @default(false)
  popularity    Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  cert        Certification @relation(fields: [certId], references: [id])
  enrollments Enrollment[]
  passes      BoosterPass[]
  orders      Order[]

  @@index([certId])
  @@index([status, recruitEnd])
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  offeringId     String
  certId         String
  plan           Plan
  status         EnrollmentStatus @default(ACTIVE)
  policyVersion  String
  rewardSnapshot Int // 참여 시점 합격 보상 (정책 변경 소급 금지)
  passId         String?          @unique
  referralCode   String?
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User                   @relation(fields: [userId], references: [id])
  offering     ChallengeOffering      @relation(fields: [offeringId], references: [id])
  pass         BoosterPass?           @relation(fields: [passId], references: [id])
  record       StudyRecord?
  verification PassVerification?
  planHistory  EnrollmentPlanChange[]

  @@unique([userId, offeringId]) // 동일 회차 중복 참여 금지
  @@index([offeringId, plan])
}

model EnrollmentPlanChange {
  id           String     @id @default(cuid())
  enrollmentId String
  fromPlan     Plan
  toPlan       Plan
  reason       String
  createdAt    DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

// ───────────────────────── 학습 · AI ─────────────────────────

/// 참여자별 학습 기록 집계 (데모 record 와 대응). 원천은 StudySession.
model StudyRecord {
  id               String     @id @default(cuid())
  enrollmentId     String     @unique
  userId           String
  progress         Float      @default(0)
  totalMin         Int        @default(0)
  streak           Int        @default(0)
  lastStudyDate    String? // Asia/Seoul 기준 YYYY-MM-DD
  accuracy         Int?
  expectedScore    Int?
  subjects         Json // [{name, accuracy, progress}]
  missions         Json // [{id,title,minutes,done,priority}]
  clearModeStarted Boolean    @default(false)
  appliedPlan      Json? // { key, recommended, appliedAt } — 데모 G6
  updatedAt        DateTime   @updatedAt
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

enum StudySessionStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  INVALID // 상한 초과 등 비정상 → 집계 제외
}

model StudySession {
  id           String             @id @default(cuid())
  userId       String
  enrollmentId String
  status       StudySessionStatus @default(RUNNING)
  startedAt    DateTime           @default(now())
  resumedAt    DateTime? // 마지막 재개 시각 (RUNNING 구간 계산용)
  elapsedSec   Int                @default(0) // 일시정지 시점까지 누적
  endedAt      DateTime?
  minutes      Int? // 확정 반영 분
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id])

  @@index([enrollmentId, status])
  @@index([userId, startedAt])
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String
  feature      String // STRATEGY | ROADMAP | ANALYSIS ...
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costMicroUsd Int      @default(0)
  success      Boolean
  errorCode    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ───────────────────────── 상품 · 결제 ─────────────────────────

/// 관리자 변경 가능 정책 (가격·보상·환불기간·XP 등). 변경 시 새 버전 행 추가.
model PolicyVersion {
  id        String   @id // 예: 2026-10-v2.2
  values    Json // { passPrice, togetherReward, boosterReward, refundDays, ... }
  isCurrent Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED // 미승인 상태에서 만료/취소
  FAILED
  REFUNDED
  PARTIAL_REFUNDED
}

model Order {
  id             String      @id @default(cuid())
  orderNo        String      @unique // PG 에 전달하는 orderId
  userId         String
  productCode    String // AI_BOOSTER_PASS
  productName    String
  offeringId     String
  certId         String
  amount         Int // 서버가 정책에서 계산한 금액 (클라이언트 값 신뢰 금지)
  vatIncluded    Boolean     @default(true)
  policyVersion  String
  status         OrderStatus @default(PENDING)
  pgProvider     String // TOSS | MOCK
  paymentKey     String?     @unique // PG 결제키 (승인 후)
  method         String?
  approvedAt     DateTime?
  refundedAmount Int         @default(0)
  refundedAt     DateTime? // 정산: 환불은 환불일 기준 반영
  failReason     String?
  isTest         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user     User              @relation(fields: [userId], references: [id])
  offering ChallengeOffering @relation(fields: [offeringId], references: [id])
  events   PaymentEvent[]
  pass     BoosterPass?

  @@index([userId, status])
  @@index([offeringId, status])
}

/// PG 이벤트(승인 응답·웹훅) 원문 보관 + eventKey 유니크로 멱등 처리
model PaymentEvent {
  id        String   @id @default(cuid())
  orderId   String
  eventKey  String   @unique
  type      String // CONFIRM_REQUEST | CONFIRMED | FAILED | CANCEL | WEBHOOK
  payload   Json
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

enum PassStatus {
  ACTIVE
  REVOKED // 환불 등으로 회수
  EXPIRED
}

/// 시험 회차당 1회 구매하는 부스터 패스(이용권)
model BoosterPass {
  id         String     @id @default(cuid())
  userId     String
  certId     String
  offeringId String
  orderId    String?    @unique
  source     String     @default("PAYMENT") // PAYMENT | ADMIN_GRANT
  status     PassStatus @default(ACTIVE)
  startAt    DateTime   @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())

  user       User              @relation(fields: [userId], references: [id])
  offering   ChallengeOffering @relation(fields: [offeringId], references: [id])
  order      Order?            @relation(fields: [orderId], references: [id])
  enrollment Enrollment?

  @@index([userId, offeringId, status])
}

// ───────────────────────── 포인트 · XP ─────────────────────────

enum PointEntryType {
  EARN // 적립 (가입축하·합격보상·초대보상)
  SPEND // 사용 (포인트몰)
  REVERSAL // 취소 역분개
  EXPIRE // 만료
  ADJUST // 관리자 조정
  RESULT // 0P 결과 기록 (불합격 등)
}

/// 포인트 원장. 절대 UPDATE/DELETE 하지 않는다. 정정은 REVERSAL 행 추가.
model PointLedgerEntry {
  id           String         @id @default(cuid())
  userId       String
  type         PointEntryType
  amount       Int // +적립 / -차감
  balanceAfter Int
  reason       String
  dedupeKey    String         @unique // 예: reward:{enrollmentId}, exchange:{orderId}
  refType      String?
  refId        String?
  reversesId   String?        @unique // 역분개 대상 (한 건은 한 번만 취소)
  expiresAt    DateTime?
  isVirtual    Boolean        @default(true) // REWARDS_LIVE=false 동안 가상 포인트
  createdById  String? // 관리자 수동 처리 시
  createdAt    DateTime       @default(now())
  user         User           @relation("PointOwner", fields: [userId], references: [id])

  @@index([userId, createdAt])
}

/// 잔액 캐시 + 낙관적 잠금 (version). 원장과 같은 트랜잭션에서만 갱신.
model PointAccount {
  userId    String   @id
  balance   Int      @default(0)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

/// 학습 XP 원장 (경제적 가치 없음 — 포인트와 분리)
model XpLedgerEntry {
  id         String   @id @default(cuid())
  userId     String
  deltaXp    Int
  sourceType String // study | test | streak | clear
  sourceId   String
  eventKey   String   @unique
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ───────────────────────── 합격 인증 ─────────────────────────

enum VerificationStatus {
  REVIEWING
  NEEDS_FIX
  APPROVED
  FAILED // 불합격 확인
  REJECTED // 증빙 부적합 반려
}

model PassVerification {
  id           String             @id @default(cuid())
  enrollmentId String             @unique // 참여당 1건 (재제출은 같은 행 갱신 + 이력)
  userId       String
  examNumber   String // 수험번호 (마스킹 저장 권장: 뒤 4자리만 평문)
  examRoundId  String?
  evidenceKey  String? // S3 object key
  status       VerificationStatus @default(REVIEWING)
  note         String?
  reviewerId   String?
  reviewedAt   DateTime?
  submittedAt  DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([status, submittedAt])
}

// ───────────────────────── 관리자 ─────────────────────────

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // VERIFICATION_APPROVE, ORDER_REFUND, POINT_ADJUST, POLICY_UPDATE ...
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

// ───────────────────────── 오픈런 (신규 챌린지 개설 요청) ─────────────────────────
// 데모 v2.9 orRequests/orInterests 규칙: 정규화 이름으로 중복 병합, 서로 다른 회원 관심 수가 목표에 도달하면
// THRESHOLD_REACHED (자동 개설 아님) → 운영자 심사 후 OPENED(회차 연결) 또는 REJECTED

enum OpenRunStatus {
  PENDING_REVIEW // 등록 직후 운영자 검토 (부적절 요청 차단)
  COLLECTING // 관심 모집 중
  THRESHOLD_REACHED // 목표 인원 도달 · 개설 심사 대기
  UNDER_REVIEW // 운영자 개설 검토 중
  OPENED // 회차 개설·연결됨
  REJECTED
}

model OpenRunRequest {
  id               String            @id @default(cuid())
  certificationKey String            @unique // 정규화 이름 (중복 요청 병합 키)
  title            String
  category         String // care, beauty, ... (자격증 분야)
  round            String? // 희망 시험 회차
  reason           String?
  requestedById    String
  status           OpenRunStatus     @default(PENDING_REVIEW)
  targetCount      Int               @default(200)
  interestCount    Int               @default(0) // 활성 관심 수 캐시 (관심 변경 트랜잭션에서만 갱신)
  certId           String? // 개설 시 연결된 자격증
  linkedOfferingId String?
  reviewNote       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  requestedBy      User              @relation("OpenRunRequester", fields: [requestedById], references: [id])
  interests        OpenRunInterest[]

  @@index([status, interestCount])
}

/// 회원 1명당 요청 1건에 관심 1개 (취소 후 재관심 가능)
model OpenRunInterest {
  requestId String
  userId    String
  active    Boolean        @default(true)
  notify    Boolean        @default(true) // 개설 시 알림
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  request   OpenRunRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestId, userId])
  @@index([userId])
}

// ───────────────────────── QUICK TEST (Phase 4) ─────────────────────────

enum QuizItemStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// 문항 은행. 출처·저작권 확인 전 문항은 PUBLISHED 금지. 데모 예시 문항은 isSample=true 로 화면에 표시.
model QuizItem {
  id          String         @id @default(cuid())
  certId      String
  subject     String
  prompt      String
  options     String[]
  answer      Int // 0-based 정답 인덱스 (응시 화면에 절대 노출하지 않음)
  explanation String?
  source      String // 출처 (자체 제작 / 기관 공개 문제 등)
  isSample    Boolean        @default(false)
  status      QuizItemStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([certId, status, subject])
}

enum QuizKind {
  QUICK
  FINAL // 시험 D-7 이하 FINAL CLEAR TEST
}

/// 응시 1회. 출제 시 문항·순서를 고정해 저장하고, 제출은 1회만 (submittedAt 조건부 갱신).
model QuizAttempt {
  id            String    @id @default(cuid())
  userId        String
  enrollmentId  String
  kind          QuizKind
  itemIds       String[]
  answers       Json? // { itemId: 선택 인덱스 }
  correct       Int?
  total         Int
  accuracy      Int?
  expectedScore Int?
  result        Json? // 과목별 정확도·과락 위험·지표 변화
  createdAt     DateTime  @default(now())
  submittedAt   DateTime?
  user          User      @relation(fields: [userId], references: [id])

  @@index([enrollmentId, createdAt])
}

// ───────────────────────── 커뮤니티 (Phase 4) ─────────────────────────

enum PostOrigin {
  COMMUNITY
  STUDY_ROOM // 스터디룸에서 작성 → 전체 커뮤니티에도 노출 (단일 원본)
}

enum ContentStatus {
  VISIBLE
  HIDDEN // 운영자 숨김
  DELETED // 작성자 삭제
}

model CommunityPost {
  id           String             @id @default(cuid())
  authorId     String
  category     String // 질문 · 응원 · 학습 기록 · 합격 후기
  title        String
  body         String
  certId       String?
  origin       PostOrigin         @default(COMMUNITY)
  roomId       String? // STUDY_ROOM 이면 회차(offering) ID
  isPublic     Boolean            @default(true) // false 면 스터디룸 안에서만 (자동 공개 꺼짐)
  status       ContentStatus      @default(VISIBLE)
  likeCount    Int                @default(0)
  viewCount    Int                @default(0)
  commentCount Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  author       User               @relation(fields: [authorId], references: [id])
  comments     CommunityComment[]
  likes        PostLike[]

  @@index([status, isPublic, createdAt])
  @@index([roomId, createdAt])
  @@index([category, createdAt])
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  body      String
  status    ContentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

/// 조회수: 회원 1인 1일 1회
model PostView {
  postId String
  userId String
  day    String // KST YYYY-MM-DD

  @@id([postId, userId, day])
}

enum ReportTarget {
  POST
  COMMENT
  CHAT
}

enum ReportStatus {
  PENDING
  HIDDEN // 운영자 숨김 처리
  DISMISSED // 문제 없음
}

/// 신고. 같은 회원이 같은 대상을 처리 전 중복 신고 불가.
model ContentReport {
  id             String       @id @default(cuid())
  reporterId     String
  targetType     ReportTarget
  targetId       String
  targetAuthorId String
  roomId         String?
  excerpt        String
  reason         String
  status         ReportStatus @default(PENDING)
  handledById    String?
  handledAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

/// 회원 간 차단 (차단한 사람의 화면에서만 숨김)
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

// ───────────────────────── 스터디룸 (Phase 4) ─────────────────────────

/// 회차(offering)당 1개. closeAt 이후 7일 읽기 전용 → 보관(채팅 삭제, 게시글 보존)
model StudyRoom {
  id        String        @id // = offeringId
  closeAt   DateTime?
  purgedAt  DateTime? // 채팅 삭제 배치 실행 시각
  autoShare Boolean       @default(true) // 스터디룸 글 전체 커뮤니티 자동 공개
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String        @id @default(cuid())
  roomId    String
  authorId  String
  kind      String        @default("text") // text | event (공부 완료 공유 등)
  body      String
  status    ContentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  room      StudyRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id])

  @@index([roomId, createdAt])
}

/// 채팅 삭제 시 신고·분쟁 메시지 보존본 (관리자 전용, 90일)
model ChatHold {
  id        String   @id @default(cuid())
  roomId    String
  messageId String   @unique
  authorId  String
  body      String
  reason    String
  holdUntil DateTime
  createdAt DateTime @default(now())
}

/// 공개 고지 확인 (스터디룸 글이 전체 커뮤니티에 공개된다는 안내)
model NoticeAck {
  userId    String
  version   String
  createdAt DateTime @default(now())

  @@id([userId, version])
}
